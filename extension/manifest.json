{
  "manifest_version": 3,
  "name": "Lamaran Tracker",
  "version": "1.3.1",
  "description": "Simpan data lowongan dari tab aktif ke Google Sheets.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_title": "Lamaran Tracker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
