{
  "manifest_version": 3,
  "name": "Lamaran Tracker",
  "version": "1.1.0",
  "description": "Simpan data lowongan dari tab aktif ke Google Sheets dengan mode AI atau Manual.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "Lamaran Tracker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
